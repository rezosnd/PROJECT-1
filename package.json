{
  "name": "cityhealth-root",
  "version": "1.0.0",
  "private": true,
  "description": "CityHealth - Live Bed & Equipment Availability with ABHA (Distributed Systems Prototype)",
  "scripts": {
    "dev": "npm --prefix apps/api run dev",
    "migrate:up": "npm --prefix apps/api run migrate:up",
    "migrate:down": "npm --prefix apps/api run migrate:down",
    "seed": "npm --prefix apps/api run seed",
    "test": "npm --prefix apps/api test",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f"
  }
}

