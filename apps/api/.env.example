# Public API origin (Google GIS JS origin + emails). Use your Vercel URL in production.
# Must match Google Cloud → Web client → Authorized JavaScript origins
PUBLIC_API_ORIGIN=https://project1-api.vercel.app

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,https://project1-api.vercel.app

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=20
