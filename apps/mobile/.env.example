# Mobile Environment Configuration

# Set to true to run fully offline with simulated socket events and mock dataset
EXPO_PUBLIC_USE_MOCKS=true

# Local Development Backend API (Replace with your computer's LAN IP e.g. 192.168.1.100)
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080/api/v1
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.100:8080

# Google Identity Services (OAuth 2.0 Client IDs created in Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Google Cloud → Web client → Authorized redirect URIs (NOT LAN IP):
#   https://auth.expo.io/@anonymous/lifelink-cityhealth
# Google rejects http://10.x.x.x:... as redirect URI (no public TLD).

